<Window x:Class="CipherVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CipherVault"
        xmlns:vm="clr-namespace:CipherVault.ViewModels"
        xmlns:converters="clr-namespace:CipherVault.Converters"
        mc:Ignorable="d"
        Title="CipherVault - Password Manager"
        Height="800" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource PrimaryDarkBrush}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="MainWindow_Loaded"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:CategoryColorConverter x:Key="CategoryColorConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        
        <Style x:Key="LogoButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Settings Panel (behind Title Bar) -->
        <Grid x:Name="SettingsPanel" Visibility="Collapsed" Margin="0,40,0,0" Panel.ZIndex="0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0D1117" Offset="0"/>
                    <GradientStop Color="#161B22" Offset="0.5"/>
                    <GradientStop Color="#0D1117" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Settings Content -->
            <ScrollViewer Margin="300,40,300,40" VerticalScrollBarVisibility="Hidden">
                <StackPanel x:Name="SettingsTabInterface" Visibility="Visible">
                <TextBlock x:Name="SettingsTitle" Text="Settings" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,32" HorizontalAlignment="Center"/>

                <TextBlock x:Name="SettingsInterfaceTitle" Text="Interface" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="SettingsLanguageLabel" Text="Language" FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="LanguageComboBox" Width="160"
                                  Style="{StaticResource ModernComboBox}"
                                  SelectionChanged="LanguageComboBox_SelectionChanged"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="SettingsFileLocationTitle" Text="File Location" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,32,0,12"/>

                <TextBlock x:Name="VaultPathDescription" Text="Vault data (encrypted passwords)" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="VaultPathTextBox" FontSize="14"
                                 Background="{StaticResource CardBackgroundBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 BorderThickness="1" Padding="12,8" IsReadOnly="True"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="VaultPathBrowseBtn" Content="Browse"
                                Style="{StaticResource SecondaryButton}" Padding="16,8" Margin="8,0,0,0"
                                Click="VaultPathBrowseBtn_Click"/>
                        <Button Grid.Column="2" x:Name="VaultPathResetBtn" Content="Reset"
                                Style="{StaticResource SecondaryButton}" Padding="16,8" Margin="8,0,0,0"
                                Click="VaultPathResetBtn_Click"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="SettingsLoggingTitle" Text="Logging" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,32,0,12"/>

                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="LoggingEnabledLabel" Text="Enable logging" FontSize="14"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" x:Name="LoggingEnabledCheckBox" Style="{StaticResource ModernCheckBox}"
                                      Checked="LoggingEnabledCheckBox_Changed" Unchecked="LoggingEnabledCheckBox_Changed"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button x:Name="OpenLogsFolderBtn" Content="Open Logs Folder"
                                    Style="{StaticResource SecondaryButton}" Padding="16,8" Margin="0,0,8,0"
                                    Click="OpenLogsFolderBtn_Click"/>
                            <Button x:Name="ClearLogsBtn" Content="Clear Logs"
                                    Style="{StaticResource SecondaryButton}" Padding="16,8"
                                    Click="ClearLogsBtn_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="SettingsDeleteVaultTitle" Text="Delete Vault" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,32,0,12"/>

                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Padding="20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="DeleteVaultBtn" Content="Delete Current Vault"
                                Style="{StaticResource DangerButton}" Padding="24,12"
                                Click="DeleteCurrentVaultBtn_Click"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="SettingsImportExportTitle" Text="Import / Export" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,32,0,12"/>

                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Padding="20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="ExportVaultBtn" Content="Export Vault"
                                Style="{StaticResource PrimaryButton}" Padding="24,12" Margin="0,0,12,0"
                                Click="ExportVaultBtn_Click"/>
                        <Button x:Name="ImportVaultBtn" Content="Import Vault"
                                Style="{StaticResource SecondaryButton}" Padding="24,12"
                                Click="ImportVaultBtn_Click"/>
                    </StackPanel>
                </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Back Button (top left) -->
            <Button Content="✕" Width="48" Height="40" FontSize="14"
                    Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                    BorderThickness="0" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Click="SettingsBackBtn_Click"/>
        </Grid>

        <!-- Custom Title Bar -->
        <Border Background="{StaticResource SecondaryDarkBrush}" Height="40" VerticalAlignment="Top" MouseLeftButtonDown="Window_MouseLeftButtonDown" Panel.ZIndex="1">
            <Grid>
                <TextBlock Text="CipherVault" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Minimize -->
                    <Button Content="&#x2500;" Width="48" Height="40" FontSize="16"
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                            BorderThickness="0" Click="Minimize_Click"/>
                    <!-- Maximize/Restore -->
                    <Button x:Name="MaximizeBtn" Content="&#x25A1;" Width="48" Height="40" FontSize="16"
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                            BorderThickness="0" Click="Maximize_Click"/>
                    <!-- Close -->
                    <Button Content="&#x2715;" Width="48" Height="40" FontSize="14"
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                            BorderThickness="0" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Login/Setup Screen -->
        <Grid x:Name="LoginScreen" Visibility="Visible" Margin="0,40,0,0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0D1117" Offset="0"/>
                    <GradientStop Color="#161B22" Offset="0.5"/>
                    <GradientStop Color="#0D1117" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Settings Button (top right) -->
            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="20" FontSize="20" Click="SettingsBtn_Click" Content="⚙"/>

            <Border Background="{StaticResource SecondaryDarkBrush}"
                    CornerRadius="20" Padding="40"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="380">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Opacity="0.3" ShadowDepth="0"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Logo -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                        <Border Width="80" Height="80" CornerRadius="20" Margin="0,0,0,20">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#58A6FF" Offset="0"/>
                                    <GradientStop Color="#A371F7" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="CV" FontSize="32" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                         <TextBlock Text="CipherVault" FontSize="28" FontWeight="Bold"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    HorizontalAlignment="Center"/>
                         <TextBlock x:Name="AppSubtitle" Text="Secure Password Manager" FontSize="14"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Vault Selection -->
                    <StackPanel x:Name="VaultSelectionPanel">
                        <TextBlock x:Name="SelectVaultTitle" Text="Select Vault" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" HorizontalAlignment="Center"/>

                        <ListBox x:Name="VaultListBox" MaxHeight="200" Margin="0,0,0,16"
                                 Style="{StaticResource VaultListBox}"
                                 ItemContainerStyle="{StaticResource VaultListBoxItem}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="10" Padding="16" Margin="0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Path}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                             <Button Grid.Column="1" Content="✕" Width="32" Height="32" FontSize="12"
                                                     Background="Transparent" Foreground="{StaticResource TextMutedBrush}"
                                                     BorderThickness="0" Cursor="Hand"
                                                     Click="DeleteVaultBtn_Click" Tag="{Binding Id}"
                                                     HorizontalAlignment="Right" VerticalAlignment="Center">
                                                 <Button.Template>
                                                     <ControlTemplate TargetType="Button">
                                                         <Border Background="Transparent">
                                                             <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                         </Border>
                                                     </ControlTemplate>
                                                 </Button.Template>
                                             </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button x:Name="CreateNewVaultBtn" Content="+ Create New Vault" Style="{StaticResource PrimaryButton}"
                                Click="ShowCreateVaultForm_Click" HorizontalAlignment="Stretch" Margin="0,0,0,16"/>

                        <TextBlock x:Name="NoVaultsMessage" Text="No vaults yet. Create one to get started." FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Create Vault Form -->
                    <StackPanel x:Name="CreateVaultForm" Visibility="Collapsed">
                        <TextBlock x:Name="CreateVaultTitle" Text="Create New Vault" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>

                        <TextBlock x:Name="VaultNameLabel" Text="Vault Name" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <TextBox x:Name="NewVaultName" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                        <TextBlock x:Name="CreateVaultMasterPassLabel" Text="Master Password" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <PasswordBox x:Name="CreateMasterPassword" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,16"/>

                        <TextBlock x:Name="CreateVaultConfirmLabel" Text="Confirm Password" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <PasswordBox x:Name="ConfirmMasterPassword" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,24"/>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="CancelCreateBtn" Content="Cancel" Style="{StaticResource SecondaryButton}"
                                    Click="CancelCreateVault_Click" Margin="0,0,12,0" Width="120"/>
                            <Button x:Name="CreateVaultBtn" Content="Create Vault" Style="{StaticResource PrimaryButton}"
                                    Click="CreateVault_Click" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Unlock Form -->
                    <StackPanel x:Name="UnlockForm" Visibility="Collapsed">
                        <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,16" MaxWidth="280" HorizontalAlignment="Center">
                            <TextBlock x:Name="SelectedVaultNameLabel" Text="Vault" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBlueBrush}" HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <TextBlock x:Name="UnlockTitle" Text="Welcome Back" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>

                        <TextBlock x:Name="UnlockMasterPassLabel" Text="Master Password" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <PasswordBox x:Name="UnlockPassword" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,24"/>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BackToVaultsBtn" Content="Back" Style="{StaticResource SecondaryButton}"
                                    Click="BackToVaults_Click" Margin="0,0,12,0" Width="120"/>
                            <Button x:Name="UnlockBtn" Content="Unlock Vault" Style="{StaticResource PrimaryButton}"
                                    Click="Unlock_Click" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Status Message -->
                    <TextBlock x:Name="LoginStatusMessage" Text="" FontSize="13"
                               Foreground="{StaticResource AccentRedBrush}"
                               HorizontalAlignment="Center" Margin="0,16,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Application -->
        <Grid x:Name="MainApp" Visibility="Collapsed" Margin="0,40,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SecondaryDarkBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo Area -->
                    <Button Grid.Row="0" Margin="24,24,24,16" Click="Logo_Click" Style="{StaticResource LogoButton}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,12,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#58A6FF" Offset="0"/>
                                        <GradientStop Color="#A371F7" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="CV" FontSize="16" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="CipherVault" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Search Box -->
                    <Border Grid.Row="1" Margin="16,0,16,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#x1F50D;" FontSize="18" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" x:Name="SearchBox" Style="{StaticResource ModernTextBox}"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     Tag="Search credentials..."/>
                        </Grid>
                    </Border>

                    <!-- Add Button -->
                    <Button Grid.Row="2" x:Name="AddNewBtn" Content="+ Add New" Style="{StaticResource PrimaryButton}"
                            Margin="16,0,16,16" Click="AddCredential_Click"/>

                    <!-- Credentials List -->
                    <ListBox Grid.Row="3" x:Name="CredentialsList"
                             Style="{StaticResource CredentialListBox}"
                             ItemContainerStyle="{StaticResource CredentialListBoxItem}"
                             ItemsSource="{Binding FilteredCredentials}"
                             SelectedItem="{Binding SelectedCredential, Mode=TwoWay}"
                             SelectionChanged="CredentialsList_SelectionChanged"
                             Margin="16,0,16,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Margin="0,0,14,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#58A6FF" Offset="0"/>
                                                <GradientStop Color="#A371F7" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="{Binding Title[0]}" FontSize="18" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,2,0,0">
                                            <Run Text="{Binding Username, Mode=OneWay}"/>
                                            <Run Text="{Binding Email, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Lock Button -->
                    <Button Grid.Row="4" x:Name="LockBtn" Content="Lock Vault" Style="{StaticResource SecondaryButton}"
                            Margin="16,16,16,40" Click="Lock_Click"/>
                </Grid>
            </Border>
            
            <!-- Main Content Area -->
            <Grid Grid.Column="1" Background="{StaticResource PrimaryDarkBrush}">
                <!-- Settings Button (top right) -->
                <Button x:Name="MainSettingsBtn" Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="20" FontSize="20" Click="SettingsBtn_Click" Content="⚙"/>

                <!-- No Selection State -->
                <StackPanel x:Name="NoSelectionPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="120" Height="120" CornerRadius="60" Margin="0,0,0,24">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#30363D" Offset="0"/>
                                <GradientStop Color="#21262D" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="🔐" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="NoSelectionTitle" Text="Select a credential" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="NoSelectionHint" Text="Choose an item from the list to view details"
                               FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Credential Details -->
                <ScrollViewer x:Name="CredentialDetails" VerticalScrollBarVisibility="Hidden" Padding="48">
                    <StackPanel MaxWidth="600">
                        <!-- Header -->
                        <Grid Margin="0,0,0,32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="72" Height="72" CornerRadius="16" Margin="0,0,20,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#58A6FF" Offset="0"/>
                                        <GradientStop Color="#A371F7" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="{Binding SelectedCredential.Title[0]}" FontSize="28" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedCredential.Title}" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding SelectedCredential.Website}" FontSize="14"
                                           Foreground="{StaticResource AccentBlueBrush}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button x:Name="EditBtn" Content="✏️" Style="{StaticResource IconButton}" ToolTip="Edit"
                                        Click="EditCredential_Click" FontSize="18"/>
                                <Button x:Name="DeleteBtn" Content="🗑️" Style="{StaticResource IconButton}" ToolTip="Delete"
                                        Click="DeleteCredential_Click" FontSize="18" Margin="4,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Info Cards -->
                        <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <!-- Username -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="UsernameLabel" Text="Username" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="UsernameText" FontSize="16"
                                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="📋" Style="{StaticResource IconButton}" ToolTip="Copy"
                                            Click="CopyUsername_Click"/>
                                </Grid>

                                <!-- Email -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="EmailLabel" Text="Email" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="EmailText" FontSize="16"
                                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="📋" Style="{StaticResource IconButton}" ToolTip="Copy"
                                            Click="CopyEmail_Click"/>
                                </Grid>

                                <!-- Password -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="PasswordLabel" Text="Password" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock x:Name="PasswordText" FontSize="16" FontFamily="Consolas"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="ShowPasswordBtn" Content="👁️" Style="{StaticResource IconButton}" ToolTip="Show"
                                            Click="ShowPassword_Click"/>
                                    <Button Grid.Column="2" Content="📋" Style="{StaticResource IconButton}" ToolTip="Copy"
                                            Click="CopyPassword_Click"/>
                                </Grid>

                                <!-- Website -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="WebsiteLabel" Text="Website" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
<TextBlock x:Name="WebsiteText" FontSize="16"
                                                    Foreground="{StaticResource AccentBlueBrush}" Margin="0,4,0,0"
                                                    Cursor="Hand" MouseLeftButtonDown="WebsiteText_MouseDown"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="📋" Style="{StaticResource IconButton}" ToolTip="Copy"
                                            Click="CopyWebsite_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Notes -->
                        <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="NotesLabel" Text="Notes" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock x:Name="NotesText" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="NotesDefault" Text="" FontSize="14"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Metadata -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <TextBlock x:Name="CreatedPrefix" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="CreatedText" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="4,0,20,0"/>
                            <TextBlock x:Name="ModifiedPrefix" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="ModifiedText" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Add/Edit Panel -->
                <Border x:Name="AddEditPanel" Background="{StaticResource SecondaryDarkBrush}"
                        HorizontalAlignment="Right" Width="420"
                        VerticalAlignment="Stretch" Margin="0,0,0,30"
                        Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="0" Direction="0"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,20">
                            <Grid>
                                <TextBlock x:Name="PanelTitle" Text="Add New Credential" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <Button Content="✕" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                                        Click="ClosePanel_Click" FontSize="16"/>
                            </Grid>
                        </Border>

                        <!-- Form -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Padding="24,20">
                            <StackPanel>
                                <TextBlock x:Name="TitleLabel" Text="Title *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <TextBox x:Name="EditTitle" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                                <TextBlock x:Name="UsernameEditLabel" Text="Username" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <TextBox x:Name="EditUsername" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                                <TextBlock x:Name="EmailEditLabel" Text="Email" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <TextBox x:Name="EditEmail" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                                <TextBlock x:Name="PasswordEditLabel" Text="Password" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <PasswordBox x:Name="EditPassword" Style="{StaticResource ModernPasswordBox}"/>
                                        <TextBox x:Name="EditPasswordVisible" Style="{StaticResource ModernTextBox}" 
                                                 Visibility="Collapsed" FontFamily="Consolas"/>
                                    </Grid>
                                    <Button Grid.Column="1" Content="🎲" Style="{StaticResource IconButton}" ToolTip="Generate"
                                            Click="ToggleGenerator_Click" Margin="4,0"/>
                                    <Button Grid.Column="2" x:Name="ShowEditPasswordBtn" Content="👁️" Style="{StaticResource IconButton}" ToolTip="Show"
                                            Click="ShowEditPassword_Click"/>
                                </Grid>

                                <!-- Password Generator -->
                                <Border x:Name="GeneratorPanel" Background="{StaticResource CardBackgroundBrush}"
                                        CornerRadius="10" Padding="16" Margin="0,0,0,16" Visibility="Collapsed">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="GeneratorTitle" Grid.Column="0" Text="Password Generator" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <Button Grid.Column="1" Content="🔄" Style="{StaticResource IconButton}" ToolTip="Regenerate"
                                                    Click="RegeneratePassword_Click"/>
                                        </Grid>

                                        <TextBox x:Name="GeneratedPassword" Style="{StaticResource ModernTextBox}" IsReadOnly="True" Margin="0,0,0,12"/>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="PasswordLengthSlider" Grid.Column="0" Minimum="8" Maximum="32" Value="16"
                                                    VerticalAlignment="Center" ValueChanged="PasswordLength_Changed"/>
                                            <TextBlock Grid.Column="1" x:Name="LengthLabel" Text="16" FontSize="14"
                                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="12,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </Grid>

                                        <StackPanel Margin="0,0,0,12">
                                            <CheckBox x:Name="ChkLowercase" Content="Lowercase (a-z)" Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="True" Checked="GeneratorOption_Changed" Unchecked="GeneratorOption_Changed"/>
                                            <CheckBox x:Name="ChkUppercase" Content="Uppercase (A-Z)" Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="True" Margin="0,8,0,0" Checked="GeneratorOption_Changed" Unchecked="GeneratorOption_Changed"/>
                                            <CheckBox x:Name="ChkDigits" Content="Numbers (0-9)" Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="True" Margin="0,8,0,0" Checked="GeneratorOption_Changed" Unchecked="GeneratorOption_Changed"/>
                                            <CheckBox x:Name="ChkSpecial" Content="Special (!@#$...)" Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="True" Margin="0,8,0,0" Checked="GeneratorOption_Changed" Unchecked="GeneratorOption_Changed"/>
                                        </StackPanel>

                                        <Grid Margin="0,0,0,8" x:Name="StrengthGrid" SizeChanged="StrengthGrid_SizeChanged">
                                            <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="3" Height="6" VerticalAlignment="Center"/>
                                            <Border x:Name="StrengthFill" Background="#3FB950" CornerRadius="3" Height="6" 
                                                    VerticalAlignment="Center" HorizontalAlignment="Left" Width="0"/>
                                            <TextBlock x:Name="StrengthLabel" Text="Weak" FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,0,0"/>
                                        </Grid>

                                        <Button x:Name="UsePasswordBtn" Content="Use Password" Style="{StaticResource PrimaryButton}"
                                                HorizontalAlignment="Stretch" Click="UseGenerated_Click"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="WebsiteEditLabel" Text="Website" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <TextBox x:Name="EditWebsite" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                                <TextBlock x:Name="NotesEditLabel" Text="Notes" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <TextBox x:Name="EditNotes" Style="{StaticResource ModernTextBox}" Height="80"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Footer -->
                        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,16">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="CancelBtn" Content="Cancel" Style="{StaticResource SecondaryButton}" Click="CancelEdit_Click" Margin="0,0,12,0"/>
                                <Button x:Name="SaveBtn" Content="Save" Style="{StaticResource PrimaryButton}" Click="SaveCredential_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Bottom"
                    Background="{StaticResource SecondaryDarkBrush}" Padding="16,8">
                <TextBlock x:Name="StatusMessage" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
            </Border>
        </Grid>

        <!-- Custom Dialog Overlay -->
        <Grid x:Name="DialogOverlay" Visibility="Collapsed" Background="#CC000000">
            <Border x:Name="DialogBorder" Background="{StaticResource SecondaryDarkBrush}" CornerRadius="16" Padding="32"
                    Width="400" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Opacity="0.6" ShadowDepth="0" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" Text="Warning" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <TextBlock x:Name="DialogMessage" Text="" FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,28"
                               TextWrapping="Wrap" LineHeight="20"/>
                    <ComboBox x:Name="DialogVaultComboBox" Style="{StaticResource ModernComboBox}"
                              Margin="0,0,0,28" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="DialogCancelBtn" Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Width="140" Margin="0,0,10,0" Click="DialogCancelBtn_Click" Visibility="Collapsed"/>
                        <Button x:Name="DialogOkBtn" Content="OK" Style="{StaticResource PrimaryButton}"
                                Width="140" Click="DialogOkBtn_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
